# Server (Vercel and local API). Never prefix secrets with VITE_.
DATABASE_URL=
OPENAI_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
MEMORY_MODEL=gpt-4.1-mini
AGENT_MODEL=gpt-4.1-mini
# Generate a random secret of at least 32 characters, stored only on the server.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Native Apple App ID, not a web Services ID.
APPLE_BUNDLE_ID=app.pocketmemory.ios
APPLE_TEAM_ID=
APPLE_KEY_ID=
# P8 private key; literal \n escapes are supported.
APPLE_PRIVATE_KEY=
# Optional comma-separated development origins for the API.
DEV_ORIGINS=http://localhost:5173

# Public build setting: HTTPS origin of your deployed Vercel API (no /api suffix).
VITE_API_URL=
# Public App Store listing, e.g. https://apps.apple.com/app/id1234567890
VITE_APP_STORE_URL=

# Optional local native build number for App Store uploads.
IOS_BUILD_NUMBER=1
