{
  "appId": "app.pocketmemory.ios",
  "appName": "Pocket Memory",
  "webDir": "dist",
  "backgroundColor": "#070709",
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "backgroundColor": "#070709"
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "style": "DARK"
    },
    "CapacitorSQLite": {
      "iosDatabaseLocation": "Library/CapacitorDatabase",
      "iosIsEncryption": false,
      "iosKeychainPrefix": "pocket-memory"
    },
    "SocialLogin": {
      "providers": {
        "google": "compileOnly",
        "facebook": "compileOnly",
        "apple": "implementation",
        "twitter": "compileOnly"
      }
    }
  }
}
